# Copy this file to ".env" and fill in your real value.
#
# SERPER_API_KEY
#   GRank uses the Serper.dev Google Search API, which returns real,
#   whole-web Google results. Sign up (free tier available) and copy your
#   key from the dashboard:
#   https://serper.dev
#
#   Note: Google's own Custom Search JSON API is closed to new accounts, so
#   it can't be used for whole-web rank checking on a newly created project.
#   Serper is the working alternative.

SERPER_API_KEY=your_serper_api_key_here

# Optional: how many result pages deep to search before giving up.
# 10 pages = top 100 results. Serper serves 10 results per page.
MAX_PAGES=10

# Optional: bias results to a country / language, matching what a searcher
# in that locale would see. Leave blank for Serper's default.
# Examples: SEARCH_COUNTRY=us  SEARCH_LANGUAGE=en
SEARCH_COUNTRY=
SEARCH_LANGUAGE=

# Optional: web server port.
PORT=5000

# Optional: logging verbosity. INFO (default) logs each term's outcome and a
# run summary. DEBUG additionally logs every request and its timing.
LOG_LEVEL=INFO
